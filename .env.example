# Copy to .env and fill in. Everything except the knowledge-base build needs these.
# LLM_PROVIDER=auto (or azure, openai, groq, gemini). Auto prefers a complete Azure setup, then OpenAI, Groq, Gemini.
LLM_PROVIDER=auto
# Optional shared password for a hosted classroom demo. Leave unset for local development.
ADVISOR_ACCESS_PASSWORD=

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment names (as created in Azure AI Foundry), not model names.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini          # any tool-calling chat model (gpt-4o, gpt-4.1-mini, ...)
# AZURE_OPENAI_DEPLOYMENT=                         # accepted alias for AZURE_OPENAI_CHAT_DEPLOYMENT
AZURE_OPENAI_EMBED_DEPLOYMENT=                    # optional: only used if Bedrock embeddings below are not set
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=whisper        # or gpt-4o-mini-transcribe
# AZURE_OPENAI_TRANSCRIBE_API_VERSION=2024-06-01  # only if your transcription deployment needs a different version

# 0 = deterministic. Set to "default" for models that reject a temperature parameter (o-series / gpt-5 family).
AZURE_OPENAI_TEMPERATURE=0

# Alternative OpenAI-compatible chat APIs. Set only the provider key(s) you have.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Embeddings via AWS Bedrock (preferred when set). Only these keys are needed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
